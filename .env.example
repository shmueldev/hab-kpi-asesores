# false = pegar a bdhabEngineer. true = números demo (solo local).
USE_DEMO_DATA=false

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRE_MINUTES=480

# Usuarios (hashes bcrypt). Copia backend/config/users.example.json
# USERS_FILE=backend/config/users.json
GENERIC_TEMP_PASSWORD=HabKpi.2026

# Redis: opcional. Memoria + disco sirven la clave periodo+asesor si Redis no está.
REDIS_URL=redis://127.0.0.1:6379/0

# Chat RescueAI (LiteLLM). Llave virtual de HA, nunca la master. Sin clave = ayuda local.
RESCUEAI_BASE_URL=https://llm.tirescue.com/v1
RESCUEAI_API_KEY=
RESCUEAI_MODEL=rescue-main

# SQL Server
# DATABASE_URL=Driver={ODBC Driver 17 for SQL Server};Server=192.168.3.155;Database=bdhabEngineer;UID=user;PWD=pass
DB_SERVER=192.168.3.155
DB_NAME=bdhabEngineer
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
